# Supabase public configuration (safe for the browser).
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://your-project-ref.supabase.co

VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only configuration. Never prefix secrets with VITE_.
LOVABLE_API_KEY=your-lovable-api-key

# Optional: only required by trusted server-side administrative operations.
# Never expose this value to client code or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
